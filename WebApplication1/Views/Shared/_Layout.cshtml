﻿﻿﻿
<!DOCTYPE html>
<html lang="ru" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Booking Agent</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">

    <style>
        body {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .card {
            border-radius: 12px;
            border: 1px solid rgba(0,0,0,.125);
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
        }

        pre code {
            display: block;
            white-space: pre-wrap;
            word-break: break-all;
            line-height: 1.5;
        }

        .text-primary {
            color: #0d6efd !important;
        }

      
        .alert {
            animation: slideDown 0.3s ease-out;
        }

        @@keyframes slideDown {
            from {
                transform: translateY(-100%);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

      
        .navbar-custom {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            position: relative;
            z-index: 1030; /* Bootstrap navbar z-index */
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
        }

       
        .dropdown-menu {
            z-index: 9999 !important; /* Очень высокий z-index */
            position: absolute !important;
            will-change: transform;
            top: 100% !important;
            right: 0 !important;
            left: auto !important;
            transform: translate3d(0, 8px, 0) !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;
            border: 1px solid rgba(0,0,0,0.1) !important;
            min-width: 280px !important; /* Шире для лучшего отображения */
        }

        .dropdown {
            position: relative !important;
            z-index: 9998 !important;
        }

        .dropdown-toggle {
            position: relative !important;
            z-index: 9997 !important;
        }

      
        header {
            isolation: isolate;
            position: relative;
            z-index: 1030;
        }

        main {
            position: relative;
            z-index: 1;
        }

       
        .dropdown-item {
            padding: 0.65rem 1.5rem !important;
            font-size: 0.95rem !important;
        }

        .dropdown-item i {
            width: 20px;
            text-align: center;
            margin-right: 12px;
            font-size: 1.1rem;
        }

        .dropdown-item.text-danger i {
            color: #dc3545;
        }

        .dropdown-item:hover {
            background-color: #f8f9fa !important;
        }

        .dropdown-item.text-danger:hover {
            background-color: #dc3545 !important;
            color: white !important;
        }

        .dropdown-item.text-danger:hover i {
            color: white !important;
        }

        .dropdown-divider {
            margin: 0.5rem 0 !important;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
   
    <header class="py-3 bg-white border-bottom shadow-sm navbar-custom">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-between">
               
                <div class="d-flex align-items-center">
                    <a asp-action="Index" asp-controller="Home" class="text-decoration-none">
                        <h1 class="h4 mb-0">
                            <i class="bi bi-person-badge text-primary me-2"></i>
                            <span class="text-dark">Booking Agent</span>
                        </h1>
                    </a>

                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="ms-4 d-none d-md-block">
                            <a asp-action="Agents" asp-controller="Home" class="btn btn-sm btn-outline-primary me-2">
                                <i class="bi bi-people me-1"></i>Все агенты
                            </a>
                            <a asp-action="GetAgent" asp-controller="Home" class="btn btn-sm btn-success">
                                <i class="bi bi-person-plus me-1"></i>Запросить
                            </a>
                        </div>
                    }
                </div>

                
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown" style="position: relative;">
                            <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2"
                                    type="button"
                                    id="userDropdown"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    data-bs-auto-close="true"
                                    data-bs-offset="0,8"
                                    data-bs-reference="parent">
                                <div class="user-avatar">
                                    @User.Identity.Name?.Substring(0, 1).ToUpper()
                                </div>
                                <span class="d-none d-md-inline">
                                    @User.Identity.Name
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger ms-1">Admin</span>
                                    }
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg" 
                                aria-labelledby="userDropdown"
                                style="position: absolute; top: 100%; right: 0; left: auto; min-width: 280px; z-index: 9999;">
                                <li>
                                    <span class="dropdown-item-text text-muted small">
                                        <i class="bi bi-envelope me-2"></i>
                                        @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a asp-action="Agents" asp-controller="Home" class="dropdown-item d-md-none">
                                        <i class="bi bi-people me-2"></i>Все агенты
                                    </a>
                                </li>
                                <li>
                                    <a asp-action="GetAgent" asp-controller="Home" class="dropdown-item d-md-none">
                                        <i class="bi bi-person-plus me-2"></i>Запросить
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider d-md-none"></li>
                                <li>
                                    <form asp-action="Logout" asp-controller="Auth" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Выйти
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-action="Login" asp-controller="Auth" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Вход
                        </a>
                    }

                    
                    <span class="badge bg-primary d-none d-md-inline">Инструкция</span>
                </div>
            </div>
        </div>
    </header>

  
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

  
    <main class="flex-shrink-0" style="position: relative; z-index: 1;">
        @RenderBody()
    </main>

    
    <footer class="mt-auto py-4 bg-white border-top" style="position: relative; z-index: 1;">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start text-muted">
                    <small>
                        &copy; @DateTime.Now.Year - Система управления тестовыми стендами
                    </small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small class="text-muted">
                        <i class="bi bi-shield-check me-1"></i>
                        Версия 1.0
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="ms-2">
                                <i class="bi bi-clock me-1"></i>
                                @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
                            </span>
                        }
                    </small>
                </div>
            </div>
        </div>
    </footer>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    
    <script>
        
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function(alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        
        document.addEventListener('DOMContentLoaded', function() {
            var dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'));
            var dropdownList = dropdownElementList.map(function (dropdownToggleEl) {
                return new bootstrap.Dropdown(dropdownToggleEl, {
                    autoClose: true,
                    offset: [0, 8]
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>