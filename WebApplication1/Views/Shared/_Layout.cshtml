<!DOCTYPE html>
<html lang="ru" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Только Bootstrap CSS + Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">

    <style>
        body {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .card {
            border-radius: 12px;
            border: 1px solid rgba(0,0,0,.125);
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
        }

        pre code {
            display: block;
            white-space: pre-wrap;
            word-break: break-all;
            line-height: 1.5;
        }

        .text-primary {
            color: #0d6efd !important;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <!-- Простой хедер -->
    <header class="py-3 bg-white border-bottom shadow-sm">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h1 class="h4 mb-0">
                        <i class="bi bi-person-badge text-primary me-2"></i>
                        Booking Agent
                    </h1>
                </div>
                <div>
                    <span class="badge bg-primary">Инструкция</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Основной контент -->
    <main class="flex-shrink-0">
        @RenderBody()
    </main>

    <!-- Простой футер -->
    <footer class="mt-auto py-3 bg-white border-top">
        <div class="container text-center text-muted">
            <small>
                &copy; @DateTime.Now.Year - Система управления тестовыми стендами
            </small>
        </div>
    </footer>

    <!-- Только Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>