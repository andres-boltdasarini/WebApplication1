@{
    ViewData["Title"] = "Доступ запрещен";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 text-center">
                <div class="card-header bg-danger text-white py-4">
                    <i class="bi bi-shield-exclamation" style="font-size: 4rem;"></i>
                    <h2 class="h3 mb-0 mt-3">Доступ запрещен</h2>
                </div>

                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-lock-fill text-danger" style="font-size: 3rem;"></i>
                    </div>

                    <h3 class="h5 text-muted mb-4">
                        У вас нет прав для доступа к этой странице
                    </h3>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-primary">
                            <i class="bi bi-house me-2"></i>
                            На главную
                        </a>
                        <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Войти как другой пользователь
                        </a>
                    </div>
                </div>

                <div class="card-footer bg-light py-3 text-muted">
                    <small>
                        Если вы считаете, что это ошибка, обратитесь к администратору
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>