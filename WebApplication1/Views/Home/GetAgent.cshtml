@model BookingAgentApp.Models.AgentRequest
@{
    ViewData["Title"] = "Запросить агента";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2><i class="bi bi-person-plus"></i> Запросить агента</h2>
        </div>
        <div class="card-body">
            <form asp-action="GetAgent" method="post">
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Ваше имя</label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="AgentId" class="form-label">Выберите агента</label>
                    <select asp-for="AgentId" class="form-select">
                        <!-- Здесь нужно получить список свободных агентов из базы -->
                        <option value="1">Агент 1</option>
                        <option value="2">Агент 2</option>
                        <option value="3">Агент 3</option>
                    </select>
                    <span asp-validation-for="AgentId" class="text-danger"></span>
                </div>
                
                <button type="submit" class="btn btn-primary">Забронировать</button>
                <a asp-action="Index" class="btn btn-secondary">Назад</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}