<!-- Views/Home/GetAgent.cshtml -->
@model BookingAgentApp.Models.AgentRequest
@{
    ViewData["Title"] = "Запросить агента";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

    
            <div class="alert alert-info alert-dismissible fade show mb-4 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="bi bi-info-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <h5 class="alert-heading mb-1">Информация</h5>
                        <p class="mb-0">Система автоматически подберет подходящего свободного агента на основе выбранных параметров</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>

           
            <div class="alert alert-light border mb-4">
                <div class="d-flex align-items-center">
                    <div class="user-avatar me-3" style="width: 40px; height: 40px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                        @User.Identity.Name?.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <small class="text-muted">Бронирование от имени</small>
                        <p class="mb-0 fw-bold">@User.Identity.Name</p>
                    </div>
                </div>
            </div>

            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h2 class="h4 mb-0">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Запрос агента
                    </h2>
                </div>

                <div class="card-body p-4">
                    <form asp-action="GetAgent" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                     
                        <div class="mb-4">
                            <label class="form-label fw-bold">Архитектура</label>
                            <div class="border rounded p-3 bg-light">
                                <div class="form-check">
                                    <input asp-for="Arch" class="form-check-input" type="radio" value="1" id="archX64" checked>
                                    <label class="form-check-label" for="archX64">
                                        X86_64
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Arch" class="form-check-input" type="radio" value="2" id="archARM">
                                    <label class="form-check-label" for="archARM">
                                        ARM
                                    </label>
                                </div>
                            </div>
                        </div>

                       
                        <div class="mb-4">
                            <div class="form-check">
                                <input asp-for="TokenS" class="form-check-input" type="checkbox" id="tokenS">
                                <label class="form-check-label fw-bold" for="tokenS">
                                    Наличие Rutoken S
                                </label>
                            </div>
                        </div>

                      
                        <div class="mb-4">
                            <label class="form-label fw-bold">Наличие ECP токена</label>
                            <div class="border rounded p-3 bg-light">
                                <div class="form-check">
                                    <input asp-for="TokenECP" class="form-check-input" type="radio" value="0" id="ecpNone" checked>
                                    <label class="form-check-label" for="ecpNone">
                                        Не нужен
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="TokenECP" class="form-check-input" type="radio" value="1" id="ecpRutoken">
                                    <label class="form-check-label" for="ecpRutoken">
                                        Рутокен ЭЦП
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="TokenECP" class="form-check-input" type="radio" value="2" id="ecpJaCarta">
                                    <label class="form-check-label" for="ecpJaCarta">
                                        JaCarta
                                    </label>
                                </div>
                            </div>
                        </div>

                     
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input asp-for="Vscode" class="form-check-input" type="checkbox" id="vscode">
                                    <label class="form-check-label fw-bold" for="vscode">
                                        Наличие VS Code
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input asp-for="Sublime" class="form-check-input" type="checkbox" id="sublime">
                                    <label class="form-check-label fw-bold" for="sublime">
                                        Наличие Sublime Text
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input asp-for="Copy" class="form-check-input" type="checkbox" id="copy" checked="checked">
                                    <label class="form-check-label fw-bold" for="copy">
                                        Сохранять резервную копию?
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input asp-for="Notif" class="form-check-input" type="checkbox" id="notif" checked="checked">
                                    <label class="form-check-label fw-bold" for="notif">
                                        Отправлять уведомление
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-bold">Начало бронирования</label>
                                <input asp-for="StartDate" class="form-control" type="date"
                                       min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-bold">Конец бронирования</label>
                                <input asp-for="EndDate" class="form-control" type="date"
                                       min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                       
                        <input type="hidden" asp-for="UserMail" value="@User.Identity.Name" />

                        <hr class="my-4">

                       
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">
                                <i class="bi bi-x-circle me-1"></i>Отмена
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>Найти и забронировать
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<style>
    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 14px;
    }
</style>

@section Scripts {
    <script>
      
        document.querySelector('form').addEventListener('submit', function(e) {
            const startDate = new Date(document.getElementById('StartDate').value);
            const endDate = new Date(document.getElementById('EndDate').value);

            if (endDate < startDate) {
                e.preventDefault();
                alert('Дата окончания не может быть раньше даты начала');
            }
        });

        
        document.getElementById('StartDate').addEventListener('change', function() {
            const startDate = this.value;
            document.getElementById('EndDate').min = startDate;

            const endDateInput = document.getElementById('EndDate');
            if (endDateInput.value && new Date(endDateInput.value) < new Date(startDate)) {
                endDateInput.value = startDate;
            }
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}