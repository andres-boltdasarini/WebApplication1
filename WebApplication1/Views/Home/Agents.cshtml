@model IEnumerable<BookingAgentApp.Models.BookingAgent>
@{
    ViewData["Title"] = "Все агенты";
}

<div class="container mt-4">
    <h2 class="mb-4">Список агентов</h2>
    
    <div class="row">
        @foreach (var agent in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header @(agent.Status == "Свободен" ? "bg-success" : "bg-danger") text-white">
                        <h5 class="mb-0">@agent.Name</h5>
                    </div>
                    <div class="card-body">
                        <p>
                            <strong>Статус:</strong>
                            <span class="badge @(agent.Status == "Свободен" ? "bg-success" : "bg-danger")">
                                @agent.Status
                            </span>
                        </p>
                        
                        <!-- Параметры агента -->
                        <div class="mb-3">
                            <strong>Параметры:</strong>
                            <ul class="list-unstyled mt-2">
                                <li><small>Архитектура: @(agent.Arch == 1 ? "X86_64" : agent.Arch == 2 ? "ARM" : "Не указана")</small></li>
                                <li><small>Rutoken S: @(agent.TokenS ? "Есть" : "Нет")</small></li>
                                <li><small>ECP токен: @(agent.TokenECP == 0 ? "Не нужен" : agent.TokenECP == 1 ? "Рутокен ЭЦП" : agent.TokenECP == 2 ? "JaCarta" : "Не указан")</small></li>
                                <li><small>VS Code: @(agent.Vscode ? "Есть" : "Нет")</small></li>
                                <li><small>Sublime: @(agent.Sublime ? "Есть" : "Нет")</small></li>
                            </ul>
                        </div>
                        
                        @if (agent.Status != "Свободен")
                        {
                            <p><strong>Занят:</strong> @agent.BookedBy</p>
                            <p><strong>Время:</strong> @agent.BookingTime</p>
                            @if (agent.EndDate.HasValue)
                            {
                                <p><strong>Освободится:</strong> @agent.EndDate.Value.InUtc().ToString("dd.MM.yyyy", null)</p>
                            }
                        }
                        
                        <a asp-action="AgentDetails" asp-route-id="@agent.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-info-circle"></i> Подробнее
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Назад
    </a>
</div>