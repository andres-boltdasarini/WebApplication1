<!-- Добавьте после информации об агенте -->
@if (!string.IsNullOrEmpty(Model.BookedBy))
{
    <div class="mt-3">
        <h6 class="text-primary mb-2">Параметры бронирования:</h6>
        <ul class="list-unstyled">
            @if (Model.Arch.HasValue)
            {
                <li><strong>Архитектура:</strong> @(Model.Arch == 1 ? "X86_64" : "ARM")</li>
            }
            @if (Model.TokenS)
            {
                <li><i class="bi bi-check-circle-fill text-success me-1"></i> Rutoken S</li>
            }
            @if (Model.TokenECP.HasValue && Model.TokenECP > 0)
            {
                <li>
                    <strong>ECP токен:</strong> 
                    @(Model.TokenECP == 1 ? "Рутокен ЭЦП" : "JaCarta")
                </li>
            }
            @if (Model.Vscode)
            {
                <li><i class="bi bi-check-circle-fill text-success me-1"></i> VS Code</li>
            }
            @if (Model.Sublime)
            {
                <li><i class="bi bi-check-circle-fill text-success me-1"></i> Sublime Text</li>
            }
            @if (Model.Notif)
            {
                <li><i class="bi bi-envelope-fill text-info me-1"></i> Уведомления включены</li>
            }
        </ul>
    </div>
}