@model PalindromeChecker.Models.IndexViewModel
@{
    ViewData["Title"] = "Калькулятор";
}

<div class="text-center">
    <h1>Умножение числа на 10</h1>
    
    <!-- Форма для ввода числа -->
    <form method="post" asp-action="Process">
        <div style="margin: 20px 0;">
            <label for="inputNumber" style="display: block; margin-bottom: 5px; font-weight: bold;">
                Введите число для умножения на 10:
            </label>
            <input type="text" 
                   id="inputNumber" 
                   name="inputNumber" 
                   class="form-control" 
                   value="@Model.InputNumber" 
                   placeholder="например: 123,45 или 1000" 
                   style="width: 300px; margin: 0 auto;" />
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top: 10px;">
            Умножить на 10
        </button>
    </form>
    
    <!-- Отображение результатов -->
    @if (Model.Result != null)
    {
        <div style="margin-top: 30px; padding: 20px; background-color: #f8f9fa; border-radius: 5px; max-width: 600px; margin-left: auto; margin-right: auto;">
            <h3>Результат:</h3>
            
            <div style="text-align: left; margin-top: 15px;">
                <p><strong>Введенное значение:</strong> @Model.Result.OriginalInput</p>
                
                @if (Model.Result.IsSuccess)
                {
                    <div style="color: green; font-weight: bold; margin-top: 10px;">
                        <p><strong>Результат умножения на 10:</strong> @Model.Result.DisplayValue</p>
                    </div>
                }
                else
                {
                    <div style="color: red; font-weight: bold; margin-top: 10px;">
                        <p><strong>Ошибка:</strong> @Model.Result.ErrorMessage</p>
                    </div>
                }
            </div>
        </div>
    }
</div>