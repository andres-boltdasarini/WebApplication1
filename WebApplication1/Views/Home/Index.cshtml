<!-- Views/Home/Index.cshtml -->
@model BookingAgentApp.Controllers.HomeViewModel
@{
    ViewData["Title"] = "Booking Agent";
}

<div class="container-fluid">
    <!-- Заголовок -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 text-primary fw-bold">Booking Agent</h1>
        </div>
    </div>

    <!-- Кнопки действий -->
    <div class="row mb-5">
        <div class="col-12">
            <button type="button" class="btn btn-primary btn-lg me-3" data-bs-toggle="modal" data-bs-target="#bookAgentModal">
                <i class="bi bi-person-plus"></i> Запросить агента
            </button>
            <a href="#agentsSection" class="btn btn-info btn-lg">
                <i class="bi bi-people"></i> Все агенты
            </a>
        </div>
    </div>

    <!-- Уведомления -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Инструкция -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white border-0">
                    <h2 class="card-title h4 text-primary fw-bold mb-0">
                        <i class="bi bi-info-circle"></i> Инструкция
                    </h2>
                </div>
                <div class="card-body">
                    @foreach (var instruction in Model.Instructions)
                    {
                        <div class="mb-4">
                            <h3 class="h5 fw-bold text-dark mb-2">@instruction.Title</h3>
                            <p class="text-muted mb-2">@instruction.Description</p>

                            @if (instruction.Steps != null)
                            {
                                foreach (var step in instruction.Steps)
                                {
                                    <p class="mb-1">@step</p>
                                }
                            }

                            @if (instruction.Title.Contains("Подключение"))
                            {
                                <div class="bg-light p-3 rounded my-3">
                                    <code class="text-dark">git/testo/virt-qa-stand/xtesto s12 u3</code>
                                    <p class="text-muted mt-2 mb-0"><small>Где s12 - номер стенда, u3 - номер юзера</small></p>
                                </div>
                            }

                            @if (instruction.Commands != null)
                            {
                                <div class="mt-3">
                                    <h5 class="fw-bold text-dark mb-2">Команды настройки окружения</h5>
                                    <div class="bg-dark text-light p-3 rounded">
                                        @foreach (var cmd in instruction.Commands)
                                        {
                                            <code class="d-block text-light mb-1">@cmd</code>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <hr />
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Список агентов -->
    <div id="agentsSection" class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white border-0">
                    <h2 class="card-title h4 text-primary fw-bold mb-0">
                        <i class="bi bi-people"></i> Все агенты
                    </h2>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Имя агента</th>
                                    <th>Статус</th>
                                    <th>Забронирован</th>
                                    <th>Время брони</th>
                                    <th>Команда подключения</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var agent in Model.Agents)
                                {
                                    <tr>
                                        <td>@agent.Id</td>
                                        <td>@agent.Name</td>
                                        <td>
                                            <span class="badge @(agent.Status == "Свободен" ? "bg-success" : "bg-danger")">
                                                @agent.Status
                                            </span>
                                        </td>
                                        <td>@(agent.BookedBy ?? "-")</td>
                                        <td>@(agent.BookingTime?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                        <td>
                                            <code class="bg-light p-1 rounded">@agent.ConnectionCommand</code>
                                        </td>
                                        <td>
                                            @if (agent.Status == "Занят")
                                            {
                                                <form method="post" asp-action="ReleaseAgent" class="d-inline">
                                                    <input type="hidden" name="id" value="@agent.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-unlock"></i> Освободить
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        onclick="bookAgent(@agent.Id)">
                                                    <i class="bi bi-bookmark"></i> Забронировать
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно бронирования -->
<div class="modal fade" id="bookAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Запросить агента</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="BookAgent">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="userName" class="form-label">Ваше имя</label>
                        <input type="text" class="form-control" id="userName" name="UserName" required>
                    </div>
                    <div class="mb-3">
                        <label for="agentId" class="form-label">Выберите агента</label>
                        <select class="form-select" id="agentId" name="AgentId" required>
                            <option value="">-- Выберите агента --</option>
                            @foreach (var agent in Model.Agents.Where(a => a.Status == "Свободен"))
                            {
                                <option value="@agent.Id">@agent.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Забронировать</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function bookAgent(agentId) {
            $('#agentId').val(agentId);
            $('#bookAgentModal').modal('show');
        }

        // Автофокус на поле имени при открытии модального окна
        $('#bookAgentModal').on('shown.bs.modal', function () {
            $('#userName').focus();
        });
    </script>
}