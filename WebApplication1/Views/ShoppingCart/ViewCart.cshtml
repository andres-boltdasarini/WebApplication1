@model ShoppingCartApp.Models.CartViewModel

@{
    ViewData["Title"] = "Корзина покупок";
}

<h2>Ваша корзина</h2>

@if (Model.Items.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Товар</th>
                <th>Цена</th>
                <th>Количество</th>
                <th>Итого</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td>@item.TotalPrice.ToString("C")</td>
                    <td>
                        <form asp-action="RemoveFromCart" method="post" class="d-inline">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end"><strong>Общая сумма:</strong></td>
                <td colspan="2"><strong>@Model.GrandTotal.ToString("C")</strong></td>
            </tr>
        </tfoot>
    </table>

    <div class="mt-3">
        <form asp-action="ClearCart" method="post">
            <button type="submit" class="btn btn-danger">Очистить корзину</button>
        </form>
    </div>
}
else
{
    <div class="alert alert-info">
        Ваша корзина пуста
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Продолжить покупки</a>
</div>