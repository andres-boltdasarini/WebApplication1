@model WebApplication1.Models.TaskItem

@{
    ViewData["Title"] = "Добавить задачу";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h1>Добавить новую задачу</h1>
            
            <form asp-action="Create">
                <div class="form-group mb-3">
                    <label asp-for="Title" class="form-label">Название задачи *</label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label">Описание (опционально)</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                
                <div class="form-group">
                    <input type="submit" value="Добавить задачу" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>